[{"url":"https://api.github.com/repos/Thinklab-SJTU/Bench2Drive/issues/comments/2750822684","html_url":"https://github.com/Thinklab-SJTU/Bench2Drive/issues/151#issuecomment-2750822684","issue_url":"https://api.github.com/repos/Thinklab-SJTU/Bench2Drive/issues/151","id":2750822684,"node_id":"IC_kwDOLx9Arc6j9jkc","user":{"login":"jayyoung0802","id":42484691,"node_id":"MDQ6VXNlcjQyNDg0Njkx","avatar_url":"https://avatars.githubusercontent.com/u/42484691?v=4","gravatar_id":"","url":"https://api.github.com/users/jayyoung0802","html_url":"https://github.com/jayyoung0802","followers_url":"https://api.github.com/users/jayyoung0802/followers","following_url":"https://api.github.com/users/jayyoung0802/following{/other_user}","gists_url":"https://api.github.com/users/jayyoung0802/gists{/gist_id}","starred_url":"https://api.github.com/users/jayyoung0802/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jayyoung0802/subscriptions","organizations_url":"https://api.github.com/users/jayyoung0802/orgs","repos_url":"https://api.github.com/users/jayyoung0802/repos","events_url":"https://api.github.com/users/jayyoung0802/events{/privacy}","received_events_url":"https://api.github.com/users/jayyoung0802/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-25T10:38:52Z","updated_at":"2025-03-25T10:38:52Z","body":"Hi @zhiwei-pg, the vukaninfo works well. We found that if it is a virtual computing resource, such as virtualizing a single-card machine from an 8-card machine, the memory is physically shared by the entire machine, which will be unstable. ","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/Thinklab-SJTU/Bench2Drive/issues/comments/2750822684/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/Thinklab-SJTU/Bench2Drive/issues/comment